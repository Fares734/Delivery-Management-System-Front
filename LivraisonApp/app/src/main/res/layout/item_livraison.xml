<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="#E8ECF4"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">


        <View
            android:id="@+id/statusBar"
            android:layout_width="4dp"
            android:layout_height="60dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_status_bar"/>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">


            <TextView
                android:id="@+id/txtCommande"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#8A94A8"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium"/>


            <TextView
                android:id="@+id/txtClient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:layout_marginTop="3dp"/>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_location_on"
                    android:layout_marginEnd="4dp"
                    app:tint="#A0A8C0"/>

                <TextView
                    android:id="@+id/txtVille"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#A0A8C0"/>

            </LinearLayout>

        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end|center_vertical">

            <com.google.android.material.chip.Chip
                android:id="@+id/txtEtat"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="false"
                android:focusable="false"
                app:chipCornerRadius="8dp"
                app:chipStrokeWidth="0dp"
                app:chipMinTouchTargetSize="0dp"
                style="@style/Widget.MaterialComponents.Chip.Action"/>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_forward_ios"
                android:layout_marginTop="10dp"
                android:layout_gravity="end"
                app:tint="#D0D8E8"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>