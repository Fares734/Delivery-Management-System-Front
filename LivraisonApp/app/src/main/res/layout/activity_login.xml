<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="750dp">

        <View
            android:id="@+id/heroBlob"
            android:layout_width="320dp"
            android:layout_height="240dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_hero_blob"/>

        <ImageView
            android:id="@+id/ivTruck"
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="60dp"
            android:src="@drawable/ic_truck"
            android:scaleType="fitCenter"
            android:contentDescription="Delivery truck"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_below="@id/ivTruck"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Se connecter"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Application mobile dédiée aux controleurs et aux livreurs pour suivre, gérer et communiquer autour des livraisons."
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="28dp"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_input_pill"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_email"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Email icon"/>

                <EditText
                    android:id="@+id/etLogin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="E-mail / Login"
                    android:textSize="14sp"
                    android:textColor="#111827"
                    android:textColorHint="#9CA3AF"
                    android:background="@null"
                    android:inputType="textEmailAddress"
                    android:importantForAutofill="no"
                    android:singleLine="true"/>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_input_pill"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_lock"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Lock icon"/>

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Mot de passe"
                    android:textSize="14sp"
                    android:textColor="#111827"
                    android:textColorHint="#9CA3AF"
                    android:background="@null"
                    android:inputType="textPassword"
                    android:importantForAutofill="no"
                    android:singleLine="true"/>
            </LinearLayout>


            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Se connecter"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_blue_pill"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:layout_marginBottom="36dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="© 2026 GestionLivraison. Tous droits réservés."
                android:textSize="11sp"
                android:textColor="#9CA3AF"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </RelativeLayout>
</ScrollView>